# Yummiii web server (FrankenPHP = Caddy + PHP)
# With a real domain in SERVER_NAME, Caddy gets and renews the HTTPS certificate by itself.

{
	frankenphp
	# Let's Encrypt emails this address if there's ever a problem with the certificate
	email {$ACME_EMAIL}
}

{$SERVER_NAME} {
	encode zstd br gzip

	# Basic security headers
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# Laravel: the API, the health check (/up) and uploaded product photos
	@laravel path /api/* /up /storage/*
	handle @laravel {
		root * /app/public
		php_server
	}

	# React: real files (JS, CSS, images), otherwise index.html for every page (/shop, /admin…)
	handle {
		root * /app/frontend
		# Built files have a unique name per version, so browsers may keep them for a year
		@assets path /assets/*
		header @assets Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}

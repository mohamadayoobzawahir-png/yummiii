# Copy this file to .env.prod ON THE SERVER and fill in every value.
# .env.prod holds passwords: never commit it or send it to anyone.

# Your domain, without https:// (e.g. yummiii.lk or www.yummiii.lk)
SERVER_NAME=yummiii.lk
# The same, with https://
APP_URL=https://yummiii.lk
# Let's Encrypt (free HTTPS) emails this address if a certificate ever has a problem
ACME_EMAIL=you@example.com

# Laravel's secret key. Create one with:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=

# Database passwords: long and random. Create each with:  openssl rand -hex 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Optional: how long an admin stays logged in, in minutes (10080 = 7 days)
# SANCTUM_TOKEN_EXPIRATION=10080
